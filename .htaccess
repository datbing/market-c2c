Options -Indexes
DirectoryIndex index.html

RewriteEngine On
RewriteBase /

# Always use HTTPS: http://... -> 301 redirect to https://...
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Block hidden files/folders (.env, .git, .htaccess...)
RewriteRule (^|/)\. - [F,L]

# Already pointing into frontend/ -> stop (avoids an infinite loop when Apache re-runs the rules)
RewriteRule ^frontend/ - [L]

# /login or /login/ -> frontend/login.html (if the file exists)
RewriteCond %{DOCUMENT_ROOT}/frontend/$1.html -f
RewriteRule ^(.+?)/?$ frontend/$1.html [L]

# Every other path -> look it up in frontend/
RewriteRule ^(.*)$ frontend/$1 [L]

ErrorDocument 403 /frontend/404.html
ErrorDocument 404 /frontend/404.html

# Do not cache HTML so code changes show up immediately; short cache for CSS/JS
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
