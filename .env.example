# ===== Server =====
PORT=3000
NODE_ENV=development

# ===== MySQL (Laragon defaults: user root, no password) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=market_c2c

# ===== Session =====
# Change to any random string
SESSION_SECRET=market-c2c-doi-chuoi-nay-thanh-chuoi-ngau-nhien
SESSION_MAX_AGE_HOURS=24

# ===== CORS =====
# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=https://market-c2c.test

# ===== HTTPS cho API =====
# Defaults to the certificate generated by Laragon (Menu > Apache > SSL > Enabled)
# Laragon installed on drive C: use the two commented lines below instead
# SSL_CERT=C:/laragon/etc/ssl/laragon.crt
# SSL_KEY=C:/laragon/etc/ssl/laragon.key
SSL_CERT=D:/laragon/etc/ssl/laragon.crt
SSL_KEY=D:/laragon/etc/ssl/laragon.key
