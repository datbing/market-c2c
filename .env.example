# ===== Server =====
PORT=3000
NODE_ENV=development

# ===== MySQL (mặc định của Laragon: user root, không mật khẩu) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=market_c2c

# ===== Session =====
# Đổi thành một chuỗi ngẫu nhiên bất kỳ
SESSION_SECRET=market-c2c-doi-chuoi-nay-thanh-chuoi-ngau-nhien
SESSION_MAX_AGE_HOURS=24

# ===== CORS =====
# Origin của frontend được gọi API (nhiều origin cách nhau bằng dấu phẩy)
CORS_ORIGINS=http://market-c2c.test
